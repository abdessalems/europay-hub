# Normalize line endings: LF in the repo, auto on checkout.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Unix shell scripts / wrapper must stay LF
*.sh   text eol=lf
mvnw   text eol=lf

# Binary files — never normalize
*.jar  binary
*.png  binary
*.jpg  binary
*.ico  binary
